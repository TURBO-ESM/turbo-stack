digraph turbo_stack_layers { rankdir=TB; compound=true;
    newrank=true;
    node [shape=box, fontname="Helvetica", fontsize=11];
    edge [fontsize=9, fontname="Helvetica"];
    splines=ortho;

    label="turbo-stack dependency contract — layers classify turbo-stack's BUILD POLICY, not ownership";
    labelloc=t; fontname="Helvetica-Bold"; fontsize=13;

    // ── Layer 4 — code turbo-stack builds (always inline) ──────────────────────
    subgraph cluster_layer4 {
        label="Layer 4 — Code turbo-stack builds\n\nSource: turbo-stack always has its own source; MARBL\nalways via submodule; MOM6 via submodule or override.\n\nBUILD: turbo-stack ALWAYS compiles it inline (add_subdirectory)";
        style=filled; color="#d8f0d8"; fontname="Helvetica-Bold";

        // MOM6 declared first -> rendered rightmost, giving its MOM6_ROOT
        // hot-swap line a clean east-side entry in the right margin.
        l4_mom6  [label="MOM6",        fillcolor="#90ee90", style=filled];
        l4_turbo [label="turbo-stack", fillcolor="#c8e6c9", style=filled];
        l4_marbl [label="MARBL",       fillcolor="#d8b4fe", style=filled];
        {rank=same; l4_mom6; l4_turbo; l4_marbl;}
    }

    // ── Layer 3 — internal (we develop) submodule libraries ────────────────────
    subgraph cluster_layer3 {
        label="Layer 3 — Internal (we develop) upstream libraries.\n\nSource: turbo-stack CAN get it via submodules but option to\noverride and bring your own development source branch or fork.\n\nBuild: turbo-stack CAN build it OR you supply a PREBUILT install\non CMAKE_PREFIX_PATH (find_package)";
        style=filled; color="#fdeede"; fontname="Helvetica-Bold";

        // Declared in reverse: visual L->R is (spacer), protoMOMxx, TIM, FMS.
        l3_fms      [label="FMS",        fillcolor="#add8e6", style=filled];
        l3_tim      [label="TIM",        fillcolor="#ffcc99", style=filled];
        l3_protomom [label="protoMOMxx", fillcolor="#ffe0b2", style=filled];
        // One invisible spacer keeps the members in the right half of the band
        // (as when Layer 3 had four members), so the TIM_ROOT and PROTOMOMXX_ROOT
        // hot-swap labels land clear of the cluster title.
        l3_padA [style=invis, width=1.0];
        {rank=same; l3_fms; l3_tim; l3_protomom; l3_padA;}
    }

    // ── Layer 2 — externals that are submodules ──────────────────────────────
    subgraph cluster_layer2 {
        label="Layer 2 — External upstream libraries that are submodules.\n\nSource: turbo-stack CAN get it via submodules.\n\nBuild: turbo-stack CAN build the source in the submodule OR you\nprovide a prebuilt install on CMAKE_PREFIX_PATH (find_package)";
        style=filled; color="#f5f5dc"; fontname="Helvetica-Bold";

        // Declared first -> rendered rightmost, so visual L->R is pFUnit, AMReX.
        l2_amrex  [label="AMReX",  fillcolor="#fffacd", style=filled];
        l2_pfunit [label="pFUnit", fillcolor="#fffacd", style=filled];
        {rank=same; l2_amrex; l2_pfunit;}
    }

    // ── Layer 1 — external tools/libraries that are not submodules ─────────────
    subgraph cluster_layer1 {
        label="Layer 1 — External tools and upstream libraries that are not\nsubmodules.\n\nSource: turbo-stack NEVER gets it for you.\n\nBuild: turbo-stack NEVER builds these; you supply them PREBUILT\n(modules / OS packages / spack / hand compiled / etc...)";
        style=filled; color="#f5f5dc"; fontname="Helvetica-Bold";

        // Declared in reverse: this layout renders a rank right-to-left, so the
        // visual L->R order is compilers, MPI, CMake, make/ninja, NetCDF, HDF5.
        l1_hdf5   [label="HDF5",                fillcolor="#fffacd", style=filled];
        l1_netcdf [label="NetCDF\n(C+Fortran)", fillcolor="#fffacd", style=filled];
        l1_make   [label="make / ninja",        fillcolor="#fffacd", style=filled];
        l1_cmake  [label="CMake >= 3.24",       fillcolor="#fffacd", style=filled];
        l1_mpi    [label="MPI",                 fillcolor="#fffacd", style=filled];
        l1_cc     [label="C/C++/Fortran\ncompilers", fillcolor="#fffacd", style=filled];
        {rank=same; l1_hdf5; l1_netcdf; l1_make; l1_cmake; l1_mpi; l1_cc;}
    }

    // Stack the layers as vertical bands (consumers on top -> prerequisites at the
    // bottom).  One invisible edge per boundary sets the order;
    // rank=same above keeps each layer a single horizontal band.  The spine is
    // anchored on each band's RIGHTMOST node so it stays a straight vertical line.
    l4_mom6  -> l3_fms   [style=invis, weight=10];
    l3_fms   -> l2_amrex [style=invis, weight=10];
    l2_amrex -> l1_hdf5  [style=invis, weight=10];

    // Hot-swap cross-cut: the co-developed TURBO-ESM repos (NOT a layer).
    // constraint=false so these annotations do not perturb the banded layout.
    hotswap [shape=note, fillcolor="#fff2cc", style=filled, fontsize=10,
             label="*_ROOT = bring your own SOURCE\n(turbo-stack still builds it; co-developed repos)\ndefault = pinned submodule"];
    // Each hot-swap target is the RIGHTMOST node in its layer, so these dashed
    // lines enter from the east side and stay in the clear right margin instead
    // of crossing the bold cluster-label text at the top of each band.
    hotswap -> l4_mom6 [style=dashed, penwidth=1.4, color="#a06000", arrowhead=odot, constraint=false, xlabel="MOM6_ROOT"];
    hotswap -> l3_fms  [style=dashed, penwidth=1.4, color="#a06000", arrowhead=odot, constraint=false, xlabel="FMS_ROOT"];
    hotswap -> l3_tim  [style=dashed, penwidth=1.4, color="#a06000", arrowhead=odot, constraint=false, xlabel="TIM_ROOT"];
    hotswap -> l3_protomom [style=dashed, penwidth=1.4, color="#a06000", arrowhead=odot, constraint=false, xlabel="PROTOMOMXX_ROOT"];
}
